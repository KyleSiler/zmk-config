// This file was generated from a template. Edit it to match your keyboard.
// See https://zmk.dev/docs/development/hardware-integration/new-shield for more instructions.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&kp TAB    &kp Q     &kp W     &kp E     &kp R      &kp T    &kp Y  &kp U      &kp I      &kp O    &kp P     &kp BSPC
&kp LCTRL  &kp A     &kp S     &kp D     &kp F      &kp G    &kp H  &kp J      &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT  &kp Z     &kp X     &kp C     &kp V      &kp B    &kp N  &kp M      &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                               &kp LGUI  &kp SPACE  &mo 1    &mo 2  &kp ENTER  &kp RALT
            >;
        };

        movement {
            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3    &kp N4     &kp N5     &kp N6          &kp N7     &kp N8        &kp N9     &kp N0  &kp BSPC
&kp LCTRL  &kp F1  &kp F2  &kp F3    &kp F4     &kp F5     &kp LEFT_ARROW  &kp DOWN   &kp UP_ARROW  &kp RIGHT  &none   &none
&kp LSHFT  &kp F6  &kp F7  &kp F8    &kp F9     &kp F10    &kp F11         &kp F12    &none         &none      &none   &kp RSHFT
                           &kp LGUI  &kp SPACE  &trans     &mo 3           &kp ENTER  &kp RALT
            >;
        };

        special {
            bindings = <
&kp TILDE  &kp EXCLAMATION  &kp AT_SIGN       &kp HASH           &kp DOLLAR  &kp PERCENT       &kp CARET  &kp AMPERSAND  &kp ASTERISK          &kp LEFT_PARENTHESIS   &kp RIGHT_PARENTHESIS  &kp BSPC
&kp RCTRL  &kp TILDE        &kp LEFT_BRACE    &kp RIGHT_BRACE    &kp EQUAL   &kp MINUS         &none      &kp PIPE       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp QUESTION           &none
&kp LSHFT  &kp GRAVE        &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp PLUS    &kp UNDERSCORE    &none      &kp BACKSLASH  &kp LESS_THAN         &kp GREATER_THAN       &kp SLASH              &kp RSHFT
                                              &kp LGUI           &kp SPACE   &mo 3             &trans     &kp ENTER      &kp RALT
            >;
        };

        function {
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans      &trans        &trans            &trans      &trans  &trans
&trans  &trans        &trans        &trans        &trans        &trans          &kp K_PREV  &kp K_STOP    &kp K_PLAY_PAUSE  &kp K_NEXT  &trans  &trans
&trans  &bt BT_CLR    &trans        &trans        &trans        &trans          &kp K_MUTE  &kp C_VOL_DN  &kp C_VOL_UP      &trans      &trans  &trans
                                    &trans        &trans        &trans          &trans      &trans        &trans
            >;
        };
    };
};
